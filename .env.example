# Database
DATABASE_URL="postgresql+asyncpg://postgres:***REMOVED***@localhost:5432/smart_bus_garage"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
REDIS_URL="redis://localhost:6379"

# JWT
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your_64_char_hex_secret_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Break Management
BREAK_TIME_PER_SHIFT=60
MIN_TRIPS_BEFORE_BREAK=1
MIN_BREAK_DURATION=10
MAX_BREAK_DURATION=30
TURNAROUND_BUFFER=10

# Shift Hours
MORNING_SHIFT_START=6
MORNING_SHIFT_END=15
EVENING_SHIFT_START=15
EVENING_SHIFT_END=24

# D3 Stagger (hours offset from shift start)
D3_SHIFT_OFFSET_HOURS=1

# Crowding Detection
CROWDING_THRESHOLD=0.85
EXTRA_DISPATCH_PREP_TIME=10

# Shift-End Protection
SHIFT_END_PROTECTION=15

# Auto-Assignment
DAILY_SCHEDULE_GENERATION_HOUR=5
DAILY_SCHEDULE_GENERATION_MINUTE=30

# Assignment Retry
ASSIGNMENT_MAX_RETRIES=3
ASSIGNMENT_RETRY_DELAY=5

# Hardware API Key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HARDWARE_API_KEY=your_cryptographic_api_key_here
