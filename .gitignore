# ─── Secrets ─────────────────────────────────────────────────────────────────
# Never commit the real environment file. Copy .env.example to .env instead.
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ─── Node / frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ─── ML model weights (download at runtime, do not vendor) ───────────────────
*.pt
*.pth
*.onnx
*.weights

# ─── Archives & database backups ─────────────────────────────────────────────
*.tar
*.tar.gz
*.zip
*.dump
*.bak

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ─── Logs & scratch ──────────────────────────────────────────────────────────
*.log
logs/
tmp/
